<?xml version="1.0" encoding="utf-8"?>
<!--
  报告 J08：Android 12+ 的备份/设备迁移规则。会话与课表缓存都排除，
  账号凭证不应出现在任何备份集合里。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sztu_schedule.xml" />
        <exclude domain="sharedpref" path="sztu_calendar.xml" />
        <exclude domain="sharedpref" path="sztu_hwsys.xml" />
        <exclude domain="sharedpref" path="sztu_hwsys_attendance.xml" />
        <exclude domain="file" path="duifenyi.ini" />
        <exclude domain="file" path="schedule.json" />
        <exclude domain="file" path="schedule.json.bak" />
        <exclude domain="file" path="schedule.json.tmp" />
        <exclude domain="file" path="hwsys_attendance" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sztu_schedule.xml" />
        <exclude domain="sharedpref" path="sztu_calendar.xml" />
        <exclude domain="sharedpref" path="sztu_hwsys.xml" />
        <exclude domain="sharedpref" path="sztu_hwsys_attendance.xml" />
        <exclude domain="file" path="hwsys_attendance" />
        <exclude domain="file" path="duifenyi.ini" />
    </device-transfer>
</data-extraction-rules>
