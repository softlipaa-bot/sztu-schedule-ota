    { "weeks": "1-16", "week": 17, "expect": "no" },
    { "weeks": "1-15单周", "week": 7, "expect": "match" },
    { "weeks": "1-15单周", "week": 8, "expect": "no" },
    { "weeks": "2-16双周", "week": 8, "expect": "match" },
    { "weeks": "2-16双周", "week": 7, "expect": "no" },
    { "weeks": "第7周,第9周,第11周", "week": 7, "expect": "match" },
    { "weeks": "第7周,第9周,第11周", "week": 9, "expect": "match" },
    { "weeks": "第7周,第9周,第11周", "week": 8, "expect": "no" },
    { "weeks": "第7周,第9周,第11周", "week": 11, "expect": "match" },
    { "weeks": "1-16周[01-02节]", "week": 8, "expect": "match" },
    { "weeks": "1-6周[01-02节]", "week": 8, "expect": "no" },
